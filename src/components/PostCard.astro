---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "featured" | "compact";
  eager?: boolean;
}

const { post, variant = "compact", eager = false } = Astro.props;
const featured = variant === "featured";
const heroImage = post.data.heroImage;
const tags = (post.data.tags ?? []).slice(0, 3);
const publishedAt = post.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/posts/${post.id}`}
  class="b-news-link group block h-full no-underline focus-visible:outline-none"
  aria-label={`Read ${post.data.title}`}
>
  <article class:list={["b-news-card", featured && "b-news-featured"]}>
    {heroImage && (
      <div class="b-news-image">
        <Image
          src={heroImage}
          format="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 768px, calc(100vw - 32px)"
          alt={post.data.heroImageAlt || post.data.title}
          width={heroImage.width}
          height={heroImage.height}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )}

    <div class="b-news-body">
      <div class="flex flex-wrap items-center gap-2">
        {featured && <span class="b-trending">Latest</span>}
        {tags.map((tag) => <span class="b-news-tag">{tag}</span>)}
      </div>

      <h3>{post.data.title}</h3>
      {post.data.description && <p>{post.data.description}</p>}

      <div class="b-news-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
        <span aria-hidden="true">•</span>
        <span class="b-read-more">
          Read more
          <span class="i-ph-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .b-news-card {
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 0.07);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 12px 34px -20px rgb(15 23 42 / 0.32);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .b-news-link:hover .b-news-card {
    border-color: rgb(37 99 235 / 0.24);
    box-shadow: 0 24px 50px -24px rgb(37 99 235 / 0.34);
    transform: translateY(-4px);
  }
  .b-news-image { aspect-ratio: 16 / 7; overflow: hidden; background: #f1f5f9; }
  .b-news-body { padding: 1.5rem 1.65rem; }
  .b-news-body h3 {
    margin-top: 1rem; color: #0f172a; font-family: "Fraunces", serif;
    font-size: clamp(1.25rem, 3vw, 1.55rem); font-weight: 700; line-height: 1.3;
    transition: color 180ms ease;
  }
  .b-news-link:hover h3 { color: #2563eb; }
  .b-news-body > p { margin-top: 0.7rem; color: #475569; font-size: 1rem; line-height: 1.65; }
  .b-news-tag, .b-trending {
    display: inline-flex; align-items: center; border-radius: 999px;
    padding: 0.3rem 0.7rem; font-size: 0.72rem; font-weight: 700;
  }
  .b-news-tag { background: #eff6ff; color: #1d4ed8; }
  .b-trending { background: #0f172a; color: white; }
  .b-news-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem;
    margin-top: 1.25rem; border-top: 1px solid #f1f5f9; padding-top: 1rem;
    color: #64748b; font-size: 0.82rem;
  }
  .b-read-more { display: inline-flex; align-items: center; gap: 0.35rem; margin-left: auto; color: #2563eb; font-weight: 700; }
  :global(html.dark) .b-news-card { border-color: rgb(255 255 255 / 0.1); background: rgb(30 41 59 / 0.9); }
  :global(html.dark) .b-news-body h3 { color: #f8fafc; }
  :global(html.dark) .b-news-link:hover h3 { color: #93c5fd; }
  :global(html.dark) .b-news-body > p { color: #cbd5e1; }
  :global(html.dark) .b-news-tag { background: rgb(30 58 138 / 0.45); color: #bfdbfe; }
  :global(html.dark) .b-news-meta { border-color: #334155; color: #94a3b8; }
  :global(html.dark) .b-read-more { color: #93c5fd; }
</style>
