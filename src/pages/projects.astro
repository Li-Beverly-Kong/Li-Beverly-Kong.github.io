---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const pageTitle = siteConfig.pageTitles.projects.title || "Projects";
const pageDescription = siteConfig.pageTitles.projects.description ||
  "Industry research experience by Li Kong.";
---

<Layout title={pageTitle} description={pageDescription} schemaType="CollectionPage">
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
    </header>

    <section class="internship-list" aria-label="Internship experience">
      {projects.map((project) => (
        <article class="internship-entry">
          <time>{project.data.period}</time>
          <div>
            <p class="internship-organization">{project.data.subtitle}</p>
            <h2>
              <a href={`/projects/${project.id}`}>{project.data.title}</a>
            </h2>
            <p class="internship-summary">{project.data.summary}</p>
            <ul class="internship-tags" aria-label="Areas">
              {project.data.tech.slice(0, 3).map((tech) => <li>{tech}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .internship-list { border-top: 1px solid #e2e8f0; }
  .internship-entry {
    display: grid; grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr); gap: 2rem;
    border-bottom: 1px solid #e2e8f0; padding-block: 2rem;
  }
  .internship-entry > time {
    color: #64748b; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem; font-variant-numeric: tabular-nums;
  }
  .internship-organization {
    color: #2563eb; font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .internship-entry h2 { margin-top: 0.35rem; font-size: clamp(1.35rem, 2.6vw, 1.7rem); line-height: 1.3; }
  .internship-entry h2 a { color: #0f172a; text-decoration: none; }
  .internship-entry h2 a:hover { color: #2563eb; }
  .internship-summary { margin-top: 0.75rem; max-width: 44rem; color: #475569; line-height: 1.7; }
  .internship-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin-top: 1rem; padding: 0; }
  .internship-tags li {
    border-radius: 999px; background: #eff6ff; padding: 0.35rem 0.7rem;
    color: #1d4ed8; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.72rem; font-weight: 700;
  }
  :global(html.dark) .internship-list,
  :global(html.dark) .internship-entry { border-color: #334155; }
  :global(html.dark) .internship-entry > time { color: #94a3b8; }
  :global(html.dark) .internship-entry h2 a { color: #f8fafc; }
  :global(html.dark) .internship-entry h2 a:hover { color: #93c5fd; }
  :global(html.dark) .internship-summary { color: #cbd5e1; }
  :global(html.dark) .internship-tags li { background: rgb(30 58 138 / 0.45); color: #bfdbfe; }
  @media (max-width: 639px) {
    .internship-entry { grid-template-columns: 1fr; gap: 0.65rem; padding-block: 1.5rem; }
  }
</style>
